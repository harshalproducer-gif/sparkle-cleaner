{
  "manifest_version": 3,
  "name": "Sparkle Cleaner",
  "version": "2.1.0",
  "version_name": "2.1.0 · by Harshal Patil",
  "description": "By Harshal Patil. Removes the visible Gemini / Flow sparkle watermark from your own images and videos. Runs 100% locally.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sparkle Cleaner",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.googleusercontent.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://labs.google/*",
    "https://storage.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
